# ─────────────────────────────────────────────────────────────────────────────
# Stellar-star environment template
#
# Copy to `.env.local` (gitignored) and fill in real values:
#     cp .env.example .env.local
#
# Only NEXT_PUBLIC_* values reach the browser bundle. Never put a secret in one:
# SUPABASE_SERVICE_ROLE_KEY and SPONSOR_OPERATOR_SECRET are server-only and
# would be world-readable if prefixed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (REQUIRED) ──────────────────────────────────────────────────────
# Project URL and anon key: Supabase dashboard → Project Settings → API.
# Without these the app starts but every query fails with
# "Supabase is not configured".
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# JWT signing secret (Project Settings → API → JWT Settings → JWT Secret).
# The server signs wallet-auth challenges with it; RLS trusts the result, so a
# wrong value makes every authenticated read return empty.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# Service-role key. Server-only, bypasses RLS. Needed by `npm run db:migrate`
# and by the oracle/onboarding routes that write tables with no client policies.
SUPABASE_SERVICE_ROLE_KEY=

# ── Stellar network ──────────────────────────────────────────────────────────
NEXT_PUBLIC_STELLAR_NETWORK=TESTNET
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_STELLAR_EXPLORER=https://stellar.expert/explorer/testnet

# ── Soroban / smart contract ─────────────────────────────────────────────────
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_CONTRACT_ID=
# Multi-asset settlement pool (docs/DESIGN_MULTI_ASSET_POOL.md)
NEXT_PUBLIC_POOL_TOKEN_ID=
NEXT_PUBLIC_SETTLEMENT_ASSET_ID=
# Public key whose signature the contract accepts on settlement attestations
NEXT_PUBLIC_SETTLEMENT_ORACLE_PUBLIC_KEY=

# ── Assets ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_USDC_ISSUER=
# Extra assets offered in the UI, as CODE:ISSUER, comma-separated
NEXT_PUBLIC_STELLAR_ASSETS=
STELLAR_CUSTOM_ASSETS=

# ── App metadata ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Stellar-star
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── FX rate providers (optional) ─────────────────────────────────────────────
# Absent keys fall back to the providers' free tiers; see docs/DESIGN_FX_RATES.md.
COINGECKO_API_KEY=
EXCHANGERATE_API_KEY=

# ── Sponsored onboarding (optional) ──────────────────────────────────────────
# Secret key of the account that funds sponsored reserves. Server-only.
# Leave empty to disable sponsored onboarding entirely.
SPONSOR_OPERATOR_SECRET=
SPONSORSHIP_CAP_STROOPS=
MAX_SPONSORSHIPS_PER_INVITER=
INVITE_COOLDOWN_MS=
INVITER_MIN_SPENDABLE_STROOPS=

# ── Observability (optional) ─────────────────────────────────────────────────
# Webhook for structured money-path error reports. Unset → server console only.
ERROR_REPORTING_WEBHOOK=
